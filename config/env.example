# --- Content engine ---
Pexels-API-Key="REPLACE_WITH_YOUR_PEXELS_API_KEY"

# --- YouTube API (Google Cloud project) ---
YT_CLIENT_ID="REPLACE_ME.apps.googleusercontent.com"
YT_CLIENT_SECRET="REPLACE_ME"
YT_REDIRECT_URI="http://localhost:1"

# --- Upload behavior ---
UPLOAD_HHMM="17:00"          # daily upload time (24h, local server time)
TIMEZONE="Asia/Kolkata"      # used by scheduler + run_daily.sh
DRY_RUN="false"              # true = build videos, skip upload

# --- Credits & pricing (passed to render engine) ---
MAX_SCENE_SECONDS=6.0
